# Copy this file to .env (in the planner folder) and put your own key in it.
# Never commit .env to git. Command-line options override these settings.

# ---- required for real runs ------------------------------------------------
OPENROUTER_API_KEY=

# ---- knowledge base to use when --db is not given --------------------------
# A folder made by the indexer (contains qa.sqlite and chroma/).
QPLAN_DB=../QARAG_Indexer/data/hotpot_glm

# ---- model slots (all through OpenRouter: "openrouter/<model id>") --------
# The five planners of the paper (searcher and writer use the same model):
#   openrouter/z-ai/glm-5.3-flash
#   openrouter/deepseek/deepseek-v4.1-flash
#   openrouter/qwen/qwen3-vl-235b-a22b-instruct
#   openrouter/google/gemini-3.8-flash
#   openrouter/anthropic/claude-haiku-5.5
QPLAN_REACT_MODEL=openrouter/z-ai/glm-5.3-flash
QPLAN_SYNTH_MODEL=openrouter/z-ai/glm-5.3-flash
#QPLAN_MEMORY_MODEL=openrouter/anthropic/claude-haiku-5.5

# ---- ReAct loop and retrieval ----------------------------------------------
QPLAN_MAX_STEPS=6
# Pairs per ReAct search (the paper's runs used 8; the code default is 5).
QPLAN_TOP_K=8
# A search hit counts as a match only at or above this cosine score.
QPLAN_MIN_SCORE=0.35
# Memory model switch (the "recall" action = an LLM answering from its own knowledge):
#   on   = allowed for a fact the knowledge base does not contain (only after searching)
#   off  = knowledge base only (used in all experiments of the paper)
#   free = any time, even before searching
QPLAN_MEMORY_POLICY=off
# Direct-first: step 0 searches the WHOLE question (k = QPLAN_DIRECT_TOP_K) and the
# writer tries to answer; if the answer is not complete, the ReAct loop starts.
#   on  = direct-first, ReAct only when needed (default)
#   off = ReAct only (ablation)
QPLAN_DIRECT_FIRST=on
QPLAN_DIRECT_TOP_K=8

# ---- temperatures and output budgets ---------------------------------------
# Budgets cover the hidden reasoning AND the visible answer (OpenRouter).
QPLAN_REACT_TEMPERATURE=0.0
QPLAN_REACT_MAX_TOKENS=4096
QPLAN_MEMORY_TEMPERATURE=0.0
QPLAN_MEMORY_MAX_TOKENS=1024
QPLAN_SYNTH_TEMPERATURE=0.0
QPLAN_SYNTH_MAX_TOKENS=4000

# ---- hidden reasoning ("thinking") -----------------------------------------
# default | off | low | medium | high   (off = OpenRouter effort "none")
# QPLAN_REASONING sets all three slots; a slot setting overrides it.
QPLAN_REASONING=default
# QPLAN_REACT_REASONING=off
# QPLAN_MEMORY_REASONING=default
# QPLAN_SYNTH_REASONING=default

# ---- where qplan keeps its run log and traces (default: QARAG_Planner/runs) -----
# QPLAN_RUNS_DIR=runs
