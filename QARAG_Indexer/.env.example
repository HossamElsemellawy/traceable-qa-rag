# Copy this file to .env (in the same folder) and put your own values in it.
# Never commit .env to git.
OPENROUTER_API_KEY=

# Needed for Wikipedia and other Wikimedia sites (they return 403 without a contact):
QARAG_USER_AGENT=qarag-research/0.1 (research; mailto:you@example.com)

# Windows console settings (optional)
PYTHONUTF8=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Generator model (QA generation, coverage pass and, by default, merging).
# The two knowledge bases of the paper:
#   KB-GLM:  openrouter/z-ai/glm-5.3-flash
#   KB-Qwen: openrouter/qwen/qwen3-vl-235b-a22b-instruct
QARAG_GEN_MODEL=openrouter/z-ai/glm-5.3-flash

# Optional overrides (defaults are in qarag/config.py; these are the paper's values)
QARAG_EMBED_MODEL=openai/text-embedding-3-large
QARAG_EMBED_VARIANT=qa
QARAG_MERGE_THRESHOLD=0.82
QARAG_CHUNK_TOKENS=1500
QARAG_OVERLAP_TOKENS=200
QARAG_LOOKAHEAD_TOKENS=300
QARAG_MAX_WORKERS=4
QARAG_DB_DIR=data/index
# QARAG_ANSWER_STYLE=sentence        (short | sentence | detailed)
# QARAG_MERGE=1                      (0 = do not merge repeated facts)
# QARAG_COVERAGE_PASS=1              (0 = no coverage pass)
# QARAG_MERGE_MODEL=                 (empty = same as generator)
# QARAG_ANSWER_MODEL=                (model for `ask`; empty = same as generator)
# QARAG_ANSWER_TOP_K=8               (QA pairs given to the answering model)

# Cost estimate when OpenRouter does not report the cost (USD per 1 million tokens;
# copy the prices from the model pages on openrouter.ai). Used by `report`.
# QARAG_PRICE_GEN_IN=
# QARAG_PRICE_GEN_OUT=
# QARAG_PRICE_EMBED=
