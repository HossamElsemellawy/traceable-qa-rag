# Copy this file to .env (in the same folder) and put your own key in it.
# Never commit .env to git.
OPENROUTER_API_KEY=

# Model that writes the answer (phase 1) and extracts the short answer (phase 2),
# unless --answer-model is given. Examples of model ids used in the paper:
#   openrouter/z-ai/glm-5.3-flash
#   openrouter/deepseek/deepseek-v4.1-flash
#   openrouter/qwen/qwen3-vl-235b-a22b-instruct
#   openrouter/google/gemini-3.8-flash
#   openrouter/anthropic/claude-haiku-5.5
#   openrouter/anthropic/claude-opus-5.5
#QARAG_ANSWER_MODEL=openrouter/z-ai/glm-5.3-flash

# Optional prices (USD per 1M tokens), used only when OpenRouter reports no cost.
#QARAG_PRICE_GEN_IN=
#QARAG_PRICE_GEN_OUT=
